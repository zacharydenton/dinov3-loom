// VARIANT: writes f16. The consumer is a matmul, which would narrow it anyway.
// GENERATED by tools/gen_f16_variants.py from layernorm_f32.loom.
// LayerNorm over the last dimension of an [tokens x hidden] f32 tensor.
//
//   y[t, c] = (x[t, c] - mean(x[t])) * rstd(x[t]) * gamma[c] + beta[c]
//   rstd    = 1 / sqrt(var + eps)      (biased variance, matching torch)
//
// DINOv3 uses LayerNorm, not RMSNorm, so ggml-hrx's kernel corpus does not
// cover it. One workgroup per token; 256 workitems, wave32, 8 subgroups.
//
// NOTE: no `where [range(%token_count, ...)]` clause on the launch signature.
// Such a constraint is part of HRX's dispatch contract, not a hint: a kernel
// carrying one miscompiles into an out-of-bounds store when launched directly
// through hipModuleLaunchKernel. See docs/notes.md.

amdgpu.target<gfx11-generic> @dinov3_layernorm_gfx11_wave32 {subgroup_size = 32}

config.decl @dinov3.layernorm_f32_f16.hidden_size : %value: index where [range(%value, 128, 32768), mul(%value, 128)]

config.decl @dinov3.layernorm_f32_f16.epsilon : f32

kernel.def target(@dinov3_layernorm_gfx11_wave32) export("dinov3_layernorm_f32_f16") @dinov3_layernorm_f32_f16(%token_count: index) {
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  kernel.launch.config workgroups(%token_count, %c1, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%token_count: index, %input: buffer, %gamma: buffer, %beta: buffer, %output: buffer) {
  %hidden_size0 = config.get @dinov3.layernorm_f32_f16.hidden_size : index
  %epsilon = config.get @dinov3.layernorm_f32_f16.epsilon : f32
  %hidden_size = index.assume %hidden_size0 [range(%hidden_size0, 128, 32768), mul(%hidden_size0, 128)] : index

  %token0 = kernel.workgroup.id<x> : index
  %workitem = kernel.workitem.id<x> : index
  %subgroup0 = kernel.subgroup.id : index
  %subgroup = index.assume %subgroup0 [range(%subgroup0, 0, 7)] : index
  %lane = kernel.subgroup.lane.id : index

  %c0 = index.constant 0 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c256 = index.constant 256 : index
  %c0_offset = index.constant 0 : offset
  %scratch_bytes = index.constant 2048 : offset
  %c0_f32 = scalar.constant 0.0 : f32

  %valid_token = index.cmp ult, %token0, %token_count : index
  %safe_token0 = scf.select %valid_token, %token0, %c0 : index
  %token = index.assume %safe_token0 [lt(%safe_token0, %token_count)] : index

  %hidden_size_i32 = index.cast %hidden_size : index to i32
  %hidden_size_f32 = scalar.sitofp %hidden_size_i32 : i32 to f32

  %input_noalias, %output_noalias = buffer.assume.noalias %input, %output : buffer, buffer
  %input_view = buffer.view %input_noalias[%c0_offset] : buffer -> view<[%token_count]x[%hidden_size]xf32>
  %output_view = buffer.view %output_noalias[%c0_offset] : buffer -> view<[%token_count]x[%hidden_size]xf16>
  %gamma_view = buffer.view %gamma[%c0_offset] : buffer -> view<[%hidden_size]xf32>
  %beta_view = buffer.view %beta[%c0_offset] : buffer -> view<[%hidden_size]xf32>

  // Pass 1: per-thread sum and sum-of-squares over this token's row.
  %thread_sum, %thread_sumsq = scf.for %channel = [%workitem to %hidden_size step %c256](%running_sum = %c0_f32 : f32, %running_sumsq = %c0_f32 : f32) -> (f32, f32) {
    %value = view.load %input_view[%token, %channel] : view<[%token_count]x[%hidden_size]xf32> -> f32
    %next_sum = scalar.addf<reassoc|nnan|ninf|nsz> %running_sum, %value : f32
    %square = scalar.mulf<reassoc|nnan|ninf|nsz> %value, %value : f32
    %next_sumsq = scalar.addf<reassoc|nnan|ninf|nsz> %running_sumsq, %square : f32
    scf.yield %next_sum, %next_sumsq : f32, f32
  }

  %subgroup_sum = kernel.subgroup.reduce<addf> %thread_sum : f32
  %subgroup_sumsq = kernel.subgroup.reduce<addf> %thread_sumsq : f32

  // scratch[0..7]   = per-subgroup sums
  // scratch[8..15]  = per-subgroup sums of squares
  // scratch[0], [1] = mean, rstd after the final reduction
  %scratch = buffer.alloca<workgroup> align(16) %scratch_bytes : buffer
  %scratch_view = buffer.view %scratch[%c0_offset] : buffer -> view<512xf32>
  %is_subgroup_leader = index.cmp eq, %lane, %c0 : index
  scf.if %is_subgroup_leader {
    %sumsq_slot = index.add %subgroup, %c8 : index
    view.store %subgroup_sum, %scratch_view[%subgroup] : f32, view<512xf32>
    view.store %subgroup_sumsq, %scratch_view[%sumsq_slot] : f32, view<512xf32>
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)

  %is_reduction_subgroup = index.cmp eq, %subgroup, %c0 : index
  %is_reduction_lane = index.cmp ult, %lane, %c8 : index
  %loads_partial = scalar.andi %is_reduction_subgroup, %is_reduction_lane : i1
  %sum_partial = scf.if %loads_partial -> (f32) {
    %value = view.load %scratch_view[%lane] : view<512xf32> -> f32
    scf.yield %value : f32
  } else {
    scf.yield %c0_f32 : f32
  }
  %sumsq_partial = scf.if %loads_partial -> (f32) {
    %slot = index.add %lane, %c8 : index
    %value = view.load %scratch_view[%slot] : view<512xf32> -> f32
    scf.yield %value : f32
  } else {
    scf.yield %c0_f32 : f32
  }
  %row_sum = kernel.subgroup.reduce<addf> %sum_partial : f32
  %row_sumsq = kernel.subgroup.reduce<addf> %sumsq_partial : f32

  %writes_stats = scalar.andi %is_reduction_subgroup, %is_subgroup_leader : i1
  scf.if %writes_stats {
    %mean = scalar.divf<reassoc|nnan|ninf|nsz|arcp> %row_sum, %hidden_size_f32 : f32
    %mean_sq = scalar.mulf<reassoc|nnan|ninf|nsz> %mean, %mean : f32
    %mean_of_sq = scalar.divf<reassoc|nnan|ninf|nsz|arcp> %row_sumsq, %hidden_size_f32 : f32
    %variance = scalar.subf<reassoc|nnan|ninf|nsz> %mean_of_sq, %mean_sq : f32
    %biased_variance = scalar.addf<reassoc|nnan|ninf|nsz> %variance, %epsilon : f32
    %rstd = scalar.rsqrtf<nnan|ninf|nsz|afn> %biased_variance : f32
    %mean_slot = index.constant 16 : index
    %rstd_slot = index.constant 17 : index
    view.store %mean, %scratch_view[%mean_slot] : f32, view<512xf32>
    view.store %rstd, %scratch_view[%rstd_slot] : f32, view<512xf32>
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)

  %mean_slot_r = index.constant 16 : index
  %rstd_slot_r = index.constant 17 : index
  %mean = view.load %scratch_view[%mean_slot_r] : view<512xf32> -> f32
  %rstd = view.load %scratch_view[%rstd_slot_r] : view<512xf32> -> f32

  // Pass 2: normalize, then apply the affine transform.
  scf.if %valid_token {
    scf.for %channel = [%workitem to %hidden_size step %c256] {
      %value = view.load %input_view[%token, %channel] : view<[%token_count]x[%hidden_size]xf32> -> f32
      %scale = view.load %gamma_view[%channel] : view<[%hidden_size]xf32> -> f32
      %shift = view.load %beta_view[%channel] : view<[%hidden_size]xf32> -> f32
      %centered = scalar.subf<reassoc|nnan|ninf|nsz> %value, %mean : f32
      %normalized = scalar.mulf<reassoc|nnan|ninf|nsz> %centered, %rstd : f32
      %scaled = scalar.mulf<reassoc|nnan|ninf|nsz> %normalized, %scale : f32
      %result = scalar.addf<reassoc|nnan|ninf|nsz> %scaled, %shift : f32
      %narrow = scalar.fptrunc %result : f32 to f16
      view.store %narrow, %output_view[%token, %channel] : f16, view<[%token_count]x[%hidden_size]xf16>
    }
  }
  kernel.return
}

// LayerNorm of an iota row is another iota, which makes the expectation exact.
// hidden = 384 (DINOv3 ViT-S+), x = 0..383, mean = 191.5, var = (N^2-1)/12.
check.case public @dinov3_layernorm_f32_f16_iota {
  %token_count = check.literal value(1) : index
  %input = check.generate.iota offset(0.0) step(1.0) : tensor<1x384xf32>
  %gamma = check.generate.fill value(1.0) : tensor<384xf32>
  %beta = check.generate.fill value(0.0) : tensor<384xf32>
  %output = check.generate.fill value(0.0) : tensor<1x384xf32>
  %expected = check.generate.iota offset(-1.7275461157337724) step(0.00902112854169072) : tensor<1x384xf32>
  kernel.launch @dinov3_layernorm_f32_f16[%token_count](%token_count, %input, %gamma, %beta, %output) : [index](index, tensor<1x384xf32>, tensor<384xf32>, tensor<384xf32>, tensor<1x384xf32>)
  check.expect.close actual(%output) expected(%expected) atol(1.0000000000000001e-05) rtol(1.0000000000000001e-05) nan(same) : tensor<1x384xf32>
  check.return
}

// A constant row has zero variance, so the result is exactly beta.
check.case public @dinov3_layernorm_f32_f16_affine {
  %token_count = check.literal value(3) : index
  %input = check.generate.fill value(7.0) : tensor<3x384xf32>
  %gamma = check.generate.fill value(2.0) : tensor<384xf32>
  %beta = check.generate.fill value(-0.5) : tensor<384xf32>
  %output = check.generate.fill value(0.0) : tensor<3x384xf32>
  %expected = check.generate.fill value(-0.5) : tensor<3x384xf32>
  kernel.launch @dinov3_layernorm_f32_f16[%token_count](%token_count, %input, %gamma, %beta, %output) : [index](index, tensor<3x384xf32>, tensor<384xf32>, tensor<384xf32>, tensor<3x384xf32>)
  check.expect.close actual(%output) expected(%expected) atol(1.0000000000000001e-05) rtol(1.0000000000000001e-05) nan(same) : tensor<3x384xf32>
  check.return
}
