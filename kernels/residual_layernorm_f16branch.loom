// VARIANT: the attention/MLP branch arrives f16. It is produced by a matmul and consumed exactly once, here, so carrying it f32 doubles its traffic for nothing.
// GENERATED by tools/gen_f16_variants.py from residual_layernorm_f32.loom.
// The residual stream is f16. It is read and written twice per layer and is
// a third of the model's memory traffic; LayerNorm renormalises it every
// layer, so the rounding does not compound (cosine is unchanged at
// 0.99998). See docs/notes.md "Lever 13".
// LayerScale + residual + LayerNorm, fused.
//
//   x[t, c]  = x[t, c] + branch[t, c] * lambda[c]        (the residual stream)
//   out[t, c] = (x[t, c] - mean(x[t])) * rstd(x[t]) * gamma[c] + beta[c]   (f16)
//
// This is inductor's `triton_per_fused_add_mul_native_layer_norm_view`: the two
// operations always occur together in a transformer block, and splitting them
// costs a launch plus a full re-read of the residual stream.
//
// hidden_size <= 512 with 256 workitems means every workitem owns at most two
// channels, so the updated values stay in registers between the two passes and
// the re-read disappears entirely.

amdgpu.target<gfx11-generic> @dinov3_residual_layernorm_gfx11 {subgroup_size = 32}

config.decl @dinov3.residual_layernorm_f32_f16branch.hidden_size : %value: index where [range(%value, 64, 512), mul(%value, 64)]

config.decl @dinov3.residual_layernorm_f32_f16branch.epsilon : f32

kernel.def target(@dinov3_residual_layernorm_gfx11) export("dinov3_residual_layernorm_f32_f16branch") @dinov3_residual_layernorm_f32_f16branch(%token_count: index) {
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  kernel.launch.config workgroups(%token_count, %c1, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%token_count: index, %x: buffer, %branch: buffer, %lambda: buffer, %gamma: buffer, %beta: buffer, %out: buffer) {
  %hidden_size0 = config.get @dinov3.residual_layernorm_f32_f16branch.hidden_size : index
  %epsilon = config.get @dinov3.residual_layernorm_f32_f16branch.epsilon : f32
  %hidden_size = index.assume %hidden_size0 [range(%hidden_size0, 64, 512), mul(%hidden_size0, 64)] : index

  %c0 = index.constant 0 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c17 = index.constant 17 : index
  %c256 = index.constant 256 : index
  %c0_offset = index.constant 0 : offset
  %scratch_bytes = index.constant 2048 : offset
  %zero = scalar.constant 0.0 : f32

  %token0 = kernel.workgroup.id<x> : index
  %workitem = kernel.workitem.id<x> : index
  %subgroup0 = kernel.subgroup.id : index
  %subgroup = index.assume %subgroup0 [range(%subgroup0, 0, 7)] : index
  %lane = kernel.subgroup.lane.id : index

  %valid = index.cmp ult, %token0, %token_count : index
  %safe_token = scf.select %valid, %token0, %c0 : index
  %token = index.assume %safe_token [lt(%safe_token, %token_count)] : index

  %hidden_i32 = index.cast %hidden_size : index to i32
  %hidden_f32 = scalar.sitofp %hidden_i32 : i32 to f32

  %x_global = buffer.assume.memory_space<global> %x : buffer
  %branch_global = buffer.assume.memory_space<global> %branch : buffer
  %lambda_global = buffer.assume.memory_space<global> %lambda : buffer
  %gamma_global = buffer.assume.memory_space<global> %gamma : buffer
  %beta_global = buffer.assume.memory_space<global> %beta : buffer
  %out_global = buffer.assume.memory_space<global> %out : buffer
  %x_view = buffer.view %x_global[%c0_offset] : buffer -> view<[%token_count]x[%hidden_size]xf16>
  %branch_view = buffer.view %branch_global[%c0_offset] : buffer -> view<[%token_count]x[%hidden_size]xf16>
  %lambda_view = buffer.view %lambda_global[%c0_offset] : buffer -> view<[%hidden_size]xf32>
  %gamma_view = buffer.view %gamma_global[%c0_offset] : buffer -> view<[%hidden_size]xf32>
  %beta_view = buffer.view %beta_global[%c0_offset] : buffer -> view<[%hidden_size]xf32>
  %out_view = buffer.view %out_global[%c0_offset] : buffer -> view<[%token_count]x[%hidden_size]xf16>

  // Channel 0 is always in range (256 workitems, hidden_size >= 256 is not
  // required but hidden_size > 256 gives each workitem a second channel).
  %channel0 = index.assume %workitem [lt(%workitem, %hidden_size)] : index
  %channel1_raw = index.add %workitem, %c256 : index
  %has_second = index.cmp ult, %channel1_raw, %hidden_size : index
  %channel1_safe = scf.select %has_second, %channel1_raw, %c0 : index
  %channel1 = index.assume %channel1_safe [lt(%channel1_safe, %hidden_size)] : index

  %residual0_half = view.load %x_view[%token, %channel0] : view<[%token_count]x[%hidden_size]xf16> -> f16
  %residual0 = scalar.extf %residual0_half : f16 to f32
  %branch0_half = view.load %branch_view[%token, %channel0] : view<[%token_count]x[%hidden_size]xf16> -> f16
  %branch0 = scalar.extf %branch0_half : f16 to f32
  %scale0 = view.load %lambda_view[%channel0] : view<[%hidden_size]xf32> -> f32
  %updated0 = scalar.fmaf<contract> %branch0, %scale0, %residual0 : f32

  %residual1_half = view.load %x_view[%token, %channel1] : view<[%token_count]x[%hidden_size]xf16> -> f16
  %residual1 = scalar.extf %residual1_half : f16 to f32
  %branch1_half = view.load %branch_view[%token, %channel1] : view<[%token_count]x[%hidden_size]xf16> -> f16
  %branch1 = scalar.extf %branch1_half : f16 to f32
  %scale1 = view.load %lambda_view[%channel1] : view<[%hidden_size]xf32> -> f32
  %updated1_raw = scalar.fmaf<contract> %branch1, %scale1, %residual1 : f32
  %updated1 = scf.select %has_second, %updated1_raw, %zero : f32

  scf.if %valid {
    %updated0_h = scalar.fptrunc %updated0 : f32 to f16
  view.store %updated0_h, %x_view[%token, %channel0] : f16, view<[%token_count]x[%hidden_size]xf16>
    scf.if %has_second {
      %updated1_h = scalar.fptrunc %updated1 : f32 to f16
  view.store %updated1_h, %x_view[%token, %channel1] : f16, view<[%token_count]x[%hidden_size]xf16>
    }
  }

  %pair_sum = scalar.addf<reassoc|nnan|ninf|nsz> %updated0, %updated1 : f32
  %square0 = scalar.mulf<reassoc|nnan|ninf|nsz> %updated0, %updated0 : f32
  %square1 = scalar.mulf<reassoc|nnan|ninf|nsz> %updated1, %updated1 : f32
  %pair_sumsq = scalar.addf<reassoc|nnan|ninf|nsz> %square0, %square1 : f32

  %subgroup_sum = kernel.subgroup.reduce<addf> %pair_sum : f32
  %subgroup_sumsq = kernel.subgroup.reduce<addf> %pair_sumsq : f32
  %scratch = buffer.alloca<workgroup> align(16) %scratch_bytes : buffer
  %scratch_view = buffer.view %scratch[%c0_offset] : buffer -> view<512xf32>
  %is_leader = index.cmp eq, %lane, %c0 : index
  scf.if %is_leader {
    %sumsq_slot = index.add %subgroup, %c8 : index
    view.store %subgroup_sum, %scratch_view[%subgroup] : f32, view<512xf32>
    view.store %subgroup_sumsq, %scratch_view[%sumsq_slot] : f32, view<512xf32>
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)

  %is_first = index.cmp eq, %subgroup, %c0 : index
  %is_reduction_lane = index.cmp ult, %lane, %c8 : index
  %reduces = scalar.andi %is_first, %is_reduction_lane : i1
  %partial_sum = scf.if %reduces -> (f32) {
    %value = view.load %scratch_view[%lane] : view<512xf32> -> f32
    scf.yield %value : f32
  } else {
    scf.yield %zero : f32
  }
  %partial_sumsq = scf.if %reduces -> (f32) {
    %slot = index.add %lane, %c8 : index
    %value = view.load %scratch_view[%slot] : view<512xf32> -> f32
    scf.yield %value : f32
  } else {
    scf.yield %zero : f32
  }
  %row_sum = kernel.subgroup.reduce<addf> %partial_sum : f32
  %row_sumsq = kernel.subgroup.reduce<addf> %partial_sumsq : f32
  %writes = scalar.andi %is_first, %is_leader : i1
  scf.if %writes {
    %mean = scalar.divf<reassoc|nnan|ninf|nsz|arcp> %row_sum, %hidden_f32 : f32
    %mean_sq = scalar.mulf<reassoc|nnan|ninf|nsz> %mean, %mean : f32
    %mean_of_sq = scalar.divf<reassoc|nnan|ninf|nsz|arcp> %row_sumsq, %hidden_f32 : f32
    %variance = scalar.subf<reassoc|nnan|ninf|nsz> %mean_of_sq, %mean_sq : f32
    %biased = scalar.addf<reassoc|nnan|ninf|nsz> %variance, %epsilon : f32
    %rstd = scalar.rsqrtf<nnan|ninf|nsz|afn> %biased : f32
    view.store %mean, %scratch_view[%c16] : f32, view<512xf32>
    view.store %rstd, %scratch_view[%c17] : f32, view<512xf32>
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %mean = view.load %scratch_view[%c16] : view<512xf32> -> f32
  %rstd = view.load %scratch_view[%c17] : view<512xf32> -> f32

  scf.if %valid {
    %gamma0 = view.load %gamma_view[%channel0] : view<[%hidden_size]xf32> -> f32
    %beta0 = view.load %beta_view[%channel0] : view<[%hidden_size]xf32> -> f32
    %centered0 = scalar.subf<reassoc|nnan|ninf|nsz> %updated0, %mean : f32
    %scaled0 = scalar.mulf<reassoc|nnan|ninf|nsz> %centered0, %rstd : f32
    %weighted0 = scalar.mulf<reassoc|nnan|ninf|nsz> %scaled0, %gamma0 : f32
    %result0 = scalar.addf<reassoc|nnan|ninf|nsz> %weighted0, %beta0 : f32
    %narrow0 = scalar.fptrunc %result0 : f32 to f16
    view.store %narrow0, %out_view[%token, %channel0] : f16, view<[%token_count]x[%hidden_size]xf16>
    scf.if %has_second {
      %gamma1 = view.load %gamma_view[%channel1] : view<[%hidden_size]xf32> -> f32
      %beta1 = view.load %beta_view[%channel1] : view<[%hidden_size]xf32> -> f32
      %centered1 = scalar.subf<reassoc|nnan|ninf|nsz> %updated1, %mean : f32
      %scaled1 = scalar.mulf<reassoc|nnan|ninf|nsz> %centered1, %rstd : f32
      %weighted1 = scalar.mulf<reassoc|nnan|ninf|nsz> %scaled1, %gamma1 : f32
      %result1 = scalar.addf<reassoc|nnan|ninf|nsz> %weighted1, %beta1 : f32
      %narrow1 = scalar.fptrunc %result1 : f32 to f16
      view.store %narrow1, %out_view[%token, %channel1] : f16, view<[%token_count]x[%hidden_size]xf16>
    }
  }
  kernel.return
}
