// VARIANT: q/k/v arrive f16, so staging them is a straight copy.
// GENERATED by tools/gen_f16_variants.py from flash_attention_f16_wmma_cf16.loom.
// VARIANT: writes f16 straight into the output projection's activation.
// GENERATED by tools/gen_f16_variants.py from flash_attention_f16_wmma.loom.
// WMMA attention for DINOv3: one workgroup per (16 query rows, head).
//
//   out[t, h, :] = softmax(q[t, h, :] . k[:, h, :]^T * scale) @ v[:, h, :]
//
// Both matmuls run on RDNA3 WMMA with f32 accumulation. Because a DINOv3 image
// is only 201 tokens, the whole score row fits in LDS and this can be a plain
// two-pass softmax -- no online rescaling, no running max/sum to carry across
// key blocks. That is a good deal simpler than a general FlashAttention and
// strictly less arithmetic.
//
// q, k and v are [tokens x qkv_stride] f32 with heads contiguous inside a
// token, which is what the fused QKV projection produces. They are narrowed to
// f16 while being staged; accumulation stays f32.
//
// LDS map (bytes), 8 wave32s, 256 workitems:
//   q_stage      0     16 x 68  f16   scaled query tile
//   kv_stage     2176  128 x 68 f16   K block, then V block
//   scores       19584 16 x 212 f32   raw then exponentiated
//   p_stage      33152 16 x 212 f16   probabilities for the P*V fragments
// Row strides are padded to odd dword counts so the 16 rows a fragment load
// touches land in different LDS banks.

amdgpu.target<gfx11-generic> @dinov3_flash_attention_gfx11 {subgroup_size = 32}

config.decl @dinov3.flash_attention_f16_wmma_cf16_af16.hidden_size : %value: index where [range(%value, 64, 8192), mul(%value, 64)]

config.decl @dinov3.flash_attention_f16_wmma_cf16_af16.qkv_stride : %value: index where [range(%value, 64, 32768), mul(%value, 64)]

config.decl @dinov3.flash_attention_f16_wmma_cf16_af16.tokens_per_image : %value: index where [range(%value, 16, 208)]

config.decl @dinov3.flash_attention_f16_wmma_cf16_af16.scale : f32

kernel.def target(@dinov3_flash_attention_gfx11) export("dinov3_flash_attention_f16_wmma_cf16_af16") @dinov3_flash_attention_f16_wmma_cf16_af16(%token_count: index, %head_count: index) {
  %c1 = index.constant 1 : index
  %c15 = index.constant 15 : index
  %c16 = index.constant 16 : index
  %c256 = index.constant 256 : index
  %tokens_per_image0 = config.get @dinov3.flash_attention_f16_wmma_cf16_af16.tokens_per_image : index
  %rounded = index.add %tokens_per_image0, %c15 : index
  %tiles_per_image = index.div %rounded, %c16 : index
  %images = index.div %token_count, %tokens_per_image0 : index
  %tiles = index.mul %images, %tiles_per_image : index
  kernel.launch.config workgroups(%tiles, %head_count, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%token_count0: index, %q: buffer, %k: buffer, %v: buffer, %out: buffer) {
  %hidden_size0 = config.get @dinov3.flash_attention_f16_wmma_cf16_af16.hidden_size : index
  %qkv_stride0 = config.get @dinov3.flash_attention_f16_wmma_cf16_af16.qkv_stride : index
  %tokens_per_image0 = config.get @dinov3.flash_attention_f16_wmma_cf16_af16.tokens_per_image : index
  %scale = config.get @dinov3.flash_attention_f16_wmma_cf16_af16.scale : f32
  %hidden_size = index.assume %hidden_size0 [range(%hidden_size0, 64, 8192), mul(%hidden_size0, 64)] : index
  %qkv_stride = index.assume %qkv_stride0 [range(%qkv_stride0, 64, 32768), mul(%qkv_stride0, 64)] : index
  %tokens_per_image = index.assume %tokens_per_image0 [range(%tokens_per_image0, 16, 208)] : index
  %token_count = index.assume %token_count0 [range(%token_count0, 1, 262144)] : index

  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c15 = index.constant 15 : index
  %c16 = index.constant 16 : index
  %c17 = index.constant 17 : index
  %c32 = index.constant 32 : index
  %c48 = index.constant 48 : index
  %c64 = index.constant 64 : index
  %c68 = index.constant 68 : index
  %c128 = index.constant 128 : index
  %c208 = index.constant 208 : index
  %c212 = index.constant 212 : index
  %c256 = index.constant 256 : index
  %c0_offset = index.constant 0 : offset
  %lds_bytes = index.constant 40064 : offset
  %kv_offset = index.constant 2176 : offset
  %scores_offset = index.constant 19584 : offset
  %p_offset = index.constant 33152 : offset
  %fragment_limit = index.constant 196 : index
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k_frag = index.constant 16 : index
  %zero = scalar.constant 0.0 : f32
  %zero_f16 = scalar.constant 0.0 : f16
  %zero_f32x8 = vector.constant 0.0 : vector<8xf32>
  %zero_f16x4 = vector.constant 0.0 : vector<4xf16>
  %neg_inf = scalar.constant -3.0000000000000001e+38 : f32

  %tile_id = kernel.workgroup.id<x> : index
  %head = kernel.workgroup.id<y> : index
  %workitem = kernel.workitem.id<x> : index
  %subgroup0 = kernel.subgroup.id : index
  %subgroup = index.assume %subgroup0 [range(%subgroup0, 0, 7)] : index
  %lane = kernel.subgroup.lane.id : index

  %rounded = index.add %tokens_per_image, %c15 : index
  %tiles_per_image = index.div %rounded, %c16 : index
  %image = index.div %tile_id, %tiles_per_image : index
  %tile_in_image = index.rem %tile_id, %tiles_per_image : index
  %image_base = index.mul %image, %tokens_per_image : index
  %query_base = index.mul %tile_in_image, %c16 : index
  %head_base = index.mul %head, %c64 : index

  %q_global = buffer.assume.memory_space<global> %q : buffer
  %k_global = buffer.assume.memory_space<global> %k : buffer
  %v_global = buffer.assume.memory_space<global> %v : buffer
  %out_global = buffer.assume.memory_space<global> %out : buffer
  %q_view = buffer.view %q_global[%c0_offset] : buffer -> view<[%token_count]x[%qkv_stride]xf16>
  %k_view = buffer.view %k_global[%c0_offset] : buffer -> view<[%token_count]x[%qkv_stride]xf16>
  %v_view = buffer.view %v_global[%c0_offset] : buffer -> view<[%token_count]x[%qkv_stride]xf16>
  %out_view = buffer.view %out_global[%c0_offset] : buffer -> view<[%token_count]x[%hidden_size]xf16>

  %lds = buffer.alloca<workgroup> align(16) %lds_bytes : buffer
  %q_stage = buffer.view %lds[%c0_offset] : buffer -> view<16x68xf16>
  %kv_stage = buffer.view %lds[%kv_offset] : buffer -> view<128x68xf16>
  // QK wants the rhs as logical [dim][key]; the staged block is [key][dim].
  %k_fragment_layout = encoding.layout.strided [1, %c68] : encoding<layout>
  %k_fragment_view = buffer.view %lds[%kv_offset] : buffer -> view<64x128xf16, %k_fragment_layout>
  // P*V wants the rhs as logical [key][dim], which is the staged order already.
  %v_fragment_layout = encoding.layout.strided [%c68, 1] : encoding<layout>
  %v_fragment_view = buffer.view %lds[%kv_offset] : buffer -> view<128x64xf16, %v_fragment_layout>
  %scores = buffer.view %lds[%scores_offset] : buffer -> view<16x212xf32>
  %p_stage = buffer.view %lds[%p_offset] : buffer -> view<16x212xf16>

  // --- stage the scaled query tile -------------------------------------------
  %load_packet = index.rem %workitem, %c16 : index
  %load_dim = index.mul %load_packet, %c4 : index
  %load_row0 = index.div %workitem, %c16 : index
  %load_row = index.assume %load_row0 [range(%load_row0, 0, 15)] : index
  %scale_vector = vector.splat %scale : vector<4xf32>
  %query_local = index.add %query_base, %load_row : index
  %query_present = index.cmp ult, %query_local, %tokens_per_image : index
  %query_row0 = index.add %image_base, %query_local : index
  %query_in_range = index.cmp ult, %query_row0, %token_count : index
  %query_ok = scalar.andi %query_present, %query_in_range : i1
  %query_row = scf.select %query_ok, %query_row0, %c0 : index
  %query_bounded = index.assume %query_row [lt(%query_row, %token_count)] : index
  %q_source0 = index.add %head_base, %load_dim : index
  %qkv_vector_limit = index.sub %qkv_stride, %c4 : index
  %q_source = index.assume %q_source0 [le(%q_source0, %qkv_vector_limit)] : index
  %q_values = scf.if %query_ok -> (vector<4xf16>) {
    %half = vector.load %q_view[%query_bounded, %q_source] : view<[%token_count]x[%qkv_stride]xf16> -> vector<4xf16>
    %wide = vector.extf %half : vector<4xf16> to vector<4xf32>
    %scaled = vector.mulf %wide, %scale_vector : vector<4xf32>
    %narrow = vector.fptrunc %scaled : vector<4xf32> to vector<4xf16>
    scf.yield %narrow : vector<4xf16>
  } else {
    scf.yield %zero_f16x4 : vector<4xf16>
  }
  vector.store %q_values, %q_stage[%load_row, %load_dim] : vector<4xf16>, view<16x68xf16>

  // --- QK^T, one 16x16 score tile per wave ----------------------------------
  %kv_load_row0 = index.div %workitem, %c16 : index
  %kv_load_row = index.assume %kv_load_row0 [range(%kv_load_row0, 0, 15)] : index
  %wave_key_offset = index.mul %subgroup, %c16 : index
  scf.for %block = [%c0 to %c208 step %c128] {
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.for %slab = [%c0 to %c128 step %c16] {
      %stage_row = index.add %slab, %kv_load_row : index
      %key_local = index.add %block, %stage_row : index
      %key_present = index.cmp ult, %key_local, %tokens_per_image : index
      %key_row0 = index.add %image_base, %key_local : index
      %key_in_range = index.cmp ult, %key_row0, %token_count : index
      %key_ok = scalar.andi %key_present, %key_in_range : i1
      %key_row = scf.select %key_ok, %key_row0, %c0 : index
      %key_bounded = index.assume %key_row [lt(%key_row, %token_count)] : index
      %values = scf.if %key_ok -> (vector<4xf16>) {
        %narrow = vector.load %k_view[%key_bounded, %q_source] : view<[%token_count]x[%qkv_stride]xf16> -> vector<4xf16>
        scf.yield %narrow : vector<4xf16>
      } else {
        scf.yield %zero_f16x4 : vector<4xf16>
      }
      vector.store %values, %kv_stage[%stage_row, %load_dim] : vector<4xf16>, view<128x68xf16>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)

    %score_init = vector.fragment<init> %zero_f32x8 shape [%m, %n] : vector<8xf32>
    %score_fragment = scf.for %dim = [%c0 to %c64 step %c16](%acc = %score_init : vector<8xf32>) -> (vector<8xf32>) unroll {
      %lhs = vector.fragment.load<lhs> %q_stage[%c0, %dim] shape [%m, %k_frag] : view<16x68xf16> -> vector<16xf16>
      %rhs = vector.fragment.load<rhs> %k_fragment_view[%dim, %wave_key_offset] shape [%k_frag, %n] : view<64x128xf16, %k_fragment_layout> -> vector<16xf16>
      %next = vector.mma %lhs, %rhs, %acc : vector<16xf16>, vector<16xf16>, vector<8xf32>
      scf.yield %next : vector<8xf32>
    }
    %score_column = index.add %block, %wave_key_offset : index
    %score_limit = index.constant 196 : index
    %in_score_range = index.cmp ule, %score_column, %score_limit : index
    scf.if %in_score_range {
      %bounded_column = index.assume %score_column [le(%score_column, %score_limit)] : index
      vector.fragment.store<result> %score_fragment, %scores[%c0, %bounded_column] shape [%m, %n] : vector<8xf32>, view<16x212xf32>
    }
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)

  // --- softmax: two query rows per wave, 32 lanes across the row ------------
  scf.for %slot = [%c0 to %c2 step %c1] {
    %row_offset = index.mul %slot, %c8 : index
    %row = index.add %subgroup, %row_offset : index
    %lane_max = scf.for %key = [%lane to %tokens_per_image step %c32](%running = %neg_inf : f32) -> (f32) {
      %value = view.load %scores[%row, %key] : view<16x212xf32> -> f32
      %next = scalar.maxnumf %running, %value : f32
      scf.yield %next : f32
    }
    %row_max = kernel.subgroup.reduce<maxnumf> %lane_max : f32
    %lane_sum = scf.for %key = [%lane to %tokens_per_image step %c32](%running = %zero : f32) -> (f32) {
      %value = view.load %scores[%row, %key] : view<16x212xf32> -> f32
      %centered = scalar.subf %value, %row_max : f32
      %weight = scalar.expf<afn> %centered : f32
      view.store %weight, %scores[%row, %key] : f32, view<16x212xf32>
      %next = scalar.addf<reassoc|nnan|ninf|nsz> %running, %weight : f32
      scf.yield %next : f32
    }
    %row_sum = kernel.subgroup.reduce<addf> %lane_sum : f32
    %one = scalar.constant 1.0 : f32
    %inverse_sum = scalar.divf<arcp> %one, %row_sum : f32
    scf.for %key = [%lane to %c208 step %c32] {
      %present = index.cmp ult, %key, %tokens_per_image : index
      %weight = scf.if %present -> (f32) {
        %value = view.load %scores[%row, %key] : view<16x212xf32> -> f32
        %normalized = scalar.mulf %value, %inverse_sum : f32
        scf.yield %normalized : f32
      } else {
        scf.yield %zero : f32
      }
      %narrow = scalar.fptrunc %weight : f32 to f16
      view.store %narrow, %p_stage[%row, %key] : f16, view<16x212xf16>
    }
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)

  // --- P*V: four output tiles, one per wave in the first half of the group --
  %output_tile = index.rem %subgroup, %c4 : index
  %output_half = index.div %subgroup, %c4 : index
  %output_column = index.mul %output_tile, %c16 : index
  %half_keys = index.mul %output_half, %c128 : index
  %product_init = vector.fragment<init> %zero_f32x8 shape [%m, %n] : vector<8xf32>
  %product = scf.for %block = [%c0 to %c208 step %c128](%outer = %product_init : vector<8xf32>) -> (vector<8xf32>) {
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.for %slab = [%c0 to %c128 step %c16] {
      %stage_row = index.add %slab, %kv_load_row : index
      %key_local = index.add %block, %stage_row : index
      %key_present = index.cmp ult, %key_local, %tokens_per_image : index
      %key_row0 = index.add %image_base, %key_local : index
      %key_in_range = index.cmp ult, %key_row0, %token_count : index
      %key_ok = scalar.andi %key_present, %key_in_range : i1
      %key_row = scf.select %key_ok, %key_row0, %c0 : index
      %key_bounded = index.assume %key_row [lt(%key_row, %token_count)] : index
      %values = scf.if %key_ok -> (vector<4xf16>) {
        %narrow = vector.load %v_view[%key_bounded, %q_source] : view<[%token_count]x[%qkv_stride]xf16> -> vector<4xf16>
        scf.yield %narrow : vector<4xf16>
      } else {
        scf.yield %zero_f16x4 : vector<4xf16>
      }
      vector.store %values, %kv_stage[%stage_row, %load_dim] : vector<4xf16>, view<128x68xf16>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)

    %inner = scf.for %step = [%c0 to %c128 step %c16](%acc = %outer : vector<8xf32>) -> (vector<8xf32>) unroll {
      %key_column = index.add %block, %step : index
      %in_range = index.cmp ule, %key_column, %fragment_limit : index
      %next = scf.if %in_range -> (vector<8xf32>) {
        %bounded = index.assume %key_column [le(%key_column, %fragment_limit)] : index
        %lhs = vector.fragment.load<lhs> %p_stage[%c0, %bounded] shape [%m, %k_frag] : view<16x212xf16> -> vector<16xf16>
        %rhs = vector.fragment.load<rhs> %v_fragment_view[%step, %output_column] shape [%k_frag, %n] : view<128x64xf16, %v_fragment_layout> -> vector<16xf16>
        %product = vector.mma %lhs, %rhs, %acc : vector<16xf16>, vector<16xf16>, vector<8xf32>
        scf.yield %product : vector<8xf32>
      } else {
        scf.yield %acc : vector<8xf32>
      }
      scf.yield %next : vector<8xf32>
    }
    scf.yield %inner : vector<8xf32>
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)

  // Publish through the score staging area, now dead.
  %is_writer = index.cmp ult, %subgroup, %c4 : index
  %result_view = buffer.view %lds[%scores_offset] : buffer -> view<16x212xf32>
  scf.if %is_writer {
    vector.fragment.store<result> %product, %result_view[%c0, %output_column] shape [%m, %n] : vector<8xf32>, view<16x212xf32>
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)

  %publish_row0 = index.div %workitem, %c16 : index
  %publish_row = index.assume %publish_row0 [range(%publish_row0, 0, 15)] : index
  %publish_dim = index.mul %load_packet, %c4 : index
  %publish_local = index.add %query_base, %publish_row : index
  %publish_present = index.cmp ult, %publish_local, %tokens_per_image : index
  %publish_row0_global = index.add %image_base, %publish_local : index
  %publish_in_range = index.cmp ult, %publish_row0_global, %token_count : index
  %publish_ok = scalar.andi %publish_present, %publish_in_range : i1
  scf.if %publish_ok {
    %bounded = index.assume %publish_row0_global [lt(%publish_row0_global, %token_count)] : index
    %wide = vector.load %result_view[%publish_row, %publish_dim] : view<16x212xf32> -> vector<4xf32>
    %values = vector.fptrunc %wide : vector<4xf32> to vector<4xf16>
    %out_slot0 = index.add %head_base, %publish_dim : index
    %hidden_vector_limit = index.sub %hidden_size, %c4 : index
    %out_slot = index.assume %out_slot0 [le(%out_slot0, %hidden_vector_limit)] : index
    vector.store %values, %out_view[%bounded, %out_slot] : vector<4xf16>, view<[%token_count]x[%hidden_size]xf16>
  }
  kernel.return
}
