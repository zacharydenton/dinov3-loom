// VARIANT: f16 in and out. Both sides are matmul handoffs; the silu itself is f32.
// GENERATED by tools/gen_f16_variants.py from swiglu_f32.loom.
// Gated MLP activation: out[t, i] = silu(gate[t, i]) * up[t, i].
//
// DINOv3 ViT-S+ sets use_gated_mlp with SiLU; plain ViT-S uses a bare GELU and
// does not need this kernel.

amdgpu.target<gfx11-generic> @dinov3_swiglu_gfx11_wave32 {subgroup_size = 32}

config.decl @dinov3.swiglu_f32_f16.width : %value: index where [range(%value, 64, 65536), mul(%value, 64)]

// Row stride of the gate and up tensors: the fused width when one matmul
// produced both halves, otherwise the same as width.
config.decl @dinov3.swiglu_f32_f16.row_stride : %value: index where [range(%value, 64, 65536), mul(%value, 64)]

kernel.def target(@dinov3_swiglu_gfx11_wave32) export("dinov3_swiglu_f32_f16") @dinov3_swiglu_f32_f16(%token_count: index) {
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  kernel.launch.config workgroups(%token_count, %c1, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%token_count: index, %gate: buffer, %up: buffer, %out: buffer) {
  %width0 = config.get @dinov3.swiglu_f32_f16.width : index
  %width = index.assume %width0 [range(%width0, 64, 65536), mul(%width0, 64)] : index
  %row_stride0 = config.get @dinov3.swiglu_f32_f16.row_stride : index
  %row_stride = index.assume %row_stride0 [range(%row_stride0, 64, 65536), mul(%row_stride0, 64)] : index
  %c0 = index.constant 0 : index
  %c256 = index.constant 256 : index
  %c0_offset = index.constant 0 : offset

  %token0 = kernel.workgroup.id<x> : index
  %workitem = kernel.workitem.id<x> : index
  %valid = index.cmp ult, %token0, %token_count : index
  %safe_token = scf.select %valid, %token0, %c0 : index
  %token = index.assume %safe_token [lt(%safe_token, %token_count)] : index

  %gate_global = buffer.assume.memory_space<global> %gate : buffer
  %up_global = buffer.assume.memory_space<global> %up : buffer
  %out_global = buffer.assume.memory_space<global> %out : buffer
  %gate_view = buffer.view %gate_global[%c0_offset] : buffer -> view<[%token_count]x[%row_stride]xf16>
  %up_view = buffer.view %up_global[%c0_offset] : buffer -> view<[%token_count]x[%row_stride]xf16>
  %out_view = buffer.view %out_global[%c0_offset] : buffer -> view<[%token_count]x[%width]xf16>

  scf.if %valid {
    scf.for %channel = [%workitem to %width step %c256] {
      %gate_half = view.load %gate_view[%token, %channel] : view<[%token_count]x[%row_stride]xf16> -> f16
      %up_half = view.load %up_view[%token, %channel] : view<[%token_count]x[%row_stride]xf16> -> f16
      %gate_value = scalar.extf %gate_half : f16 to f32
      %up_value = scalar.extf %up_half : f16 to f32
      %activated = scalar.siluf<afn> %gate_value : f32
      %result = scalar.mulf %activated, %up_value : f32
      %narrow = scalar.fptrunc %result : f32 to f16
      view.store %narrow, %out_view[%token, %channel] : f16, view<[%token_count]x[%width]xf16>
    }
  }
  kernel.return
}
