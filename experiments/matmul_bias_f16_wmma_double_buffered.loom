// C[m, n] = sum_k A[m, k] * W[n, k] + bias[n], through RDNA3 WMMA.
//
// A arrives as f32 and is narrowed to f16 while it is staged into LDS, so the
// rest of the model keeps its f32 activations and only the weights change dtype.
// W is f16 in memory, which also halves the weight bandwidth that dominates the
// down and gate/up projections. Accumulation is f32 — the same arithmetic
// hipBLASLt does for torch's fp16 path.
//
// One workgroup computes a 64x64 tile with 8 wave32s arranged 4x2; each wave
// owns a 16x32 block, held as two 16x16 accumulator fragments.
//
// LDS rows are padded from 32 to 40 f16 for the usual bank reason.
//
// N must be a multiple of 64 and K of 32. M is a runtime value, bounds-checked.

amdgpu.target<gfx11-generic> @dinov3_matmul_wmma_gfx11 {subgroup_size = 32}

config.decl @dinov3.matmul_bias_f16_wmma.k_size : %value: index where [range(%value, 32, 8192), mul(%value, 32)]

config.decl @dinov3.matmul_bias_f16_wmma.n_size : %value: index where [range(%value, 64, 8192), mul(%value, 64)]

kernel.def target(@dinov3_matmul_wmma_gfx11) export("dinov3_matmul_bias_f16_wmma") @dinov3_matmul_bias_f16_wmma(%m_size: index) {
  %c1 = index.constant 1 : index
  %c63 = index.constant 63 : index
  %c64 = index.constant 64 : index
  %c256 = index.constant 256 : index
  %n_size0 = config.get @dinov3.matmul_bias_f16_wmma.n_size : index
  %m_rounded = index.add %m_size, %c63 : index
  %m_tiles = index.div %m_rounded, %c64 : index
  %n_tiles = index.div %n_size0, %c64 : index
  kernel.launch.config workgroups(%n_tiles, %m_tiles, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%m_size: index, %a: buffer, %w: buffer, %bias: buffer, %c: buffer) {
  %k_size0 = config.get @dinov3.matmul_bias_f16_wmma.k_size : index
  %n_size0 = config.get @dinov3.matmul_bias_f16_wmma.n_size : index
  %k_size = index.assume %k_size0 [range(%k_size0, 32, 8192), mul(%k_size0, 32)] : index
  %n_size = index.assume %n_size0 [range(%n_size0, 64, 8192), mul(%n_size0, 64)] : index

  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c40 = index.constant 40 : index
  %c64 = index.constant 64 : index
  %c256 = index.constant 256 : index
  %c0_offset = index.constant 0 : offset
  %a_stage_bytes = index.constant 10240 : offset
  %w_stage_bytes = index.constant 10240 : offset
  %result_stage_bytes = index.constant 8192 : offset
  %wave_result_bytes = index.constant 1024 : offset
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %zero_f32x8 = vector.constant 0.0 : vector<8xf32>
  %zero_f16x4 = vector.constant 0.0 : vector<4xf16>

  %tile_n_id = kernel.workgroup.id<x> : index
  %tile_m_id = kernel.workgroup.id<y> : index
  %workitem = kernel.workitem.id<x> : index
  %subgroup0 = kernel.subgroup.id : index
  %subgroup = index.assume %subgroup0 [range(%subgroup0, 0, 7)] : index
  %lane = kernel.subgroup.lane.id : index

  %wave_m = index.div %subgroup, %c2 : index
  %wave_n = index.rem %subgroup, %c2 : index
  %wave_row = index.mul %wave_m, %c16 : index
  %wave_col = index.mul %wave_n, %c32 : index
  %wave_col1 = index.add %wave_col, %c16 : index
  %base_m = index.mul %tile_m_id, %c64 : index
  %base_n = index.mul %tile_n_id, %c64 : index

  %a_global = buffer.assume.memory_space<global> %a : buffer
  %w_global = buffer.assume.memory_space<global> %w : buffer
  %bias_global = buffer.assume.memory_space<global> %bias : buffer
  %c_global = buffer.assume.memory_space<global> %c : buffer
  %a_view = buffer.view %a_global[%c0_offset] : buffer -> view<[%m_size]x[%k_size]xf32>
  %w_view = buffer.view %w_global[%c0_offset] : buffer -> view<[%n_size]x[%k_size]xf16>
  %bias_view = buffer.view %bias_global[%c0_offset] : buffer -> view<[%n_size]xf32>
  %c_view = buffer.view %c_global[%c0_offset] : buffer -> view<[%m_size]x[%n_size]xf32>

  %a_stage = buffer.alloca<workgroup> align(16) %a_stage_bytes : buffer
  %w_stage = buffer.alloca<workgroup> align(16) %w_stage_bytes : buffer
  %result_stage = buffer.alloca<workgroup> align(16) %result_stage_bytes : buffer
  %a_stage_view = buffer.view %a_stage[%c0_offset] : buffer -> view<128x40xf16>
  %w_stage_view = buffer.view %w_stage[%c0_offset] : buffer -> view<128x40xf16>
  // The rhs fragment wants logical [k][n]; the staged weight tile is physically
  // [n][k] with a 40-element row, so a strided layout reads it transposed.
  %w_fragment_layout = encoding.layout.strided [1, %c40] : encoding<layout>
  %w_fragment_view = buffer.view %w_stage[%c0_offset] : buffer -> view<32x128xf16, %w_fragment_layout>
  %wave_result_offset = index.scale %subgroup, %wave_result_bytes : index, offset -> offset
  %result_view = buffer.view %result_stage[%wave_result_offset] : buffer -> view<16x16xf32>

  %load_packet = index.rem %workitem, %c8 : index
  %load_k = index.mul %load_packet, %c4 : index
  %load_row0 = index.div %workitem, %c8 : index
  %load_row = index.assume %load_row0 [range(%load_row0, 0, 31)] : index
  %load_row_high = index.add %load_row, %c32 : index

  %acc_init0 = vector.fragment<init> %zero_f32x8 shape [%m, %n] : vector<8xf32>
  %acc_init1 = vector.fragment<init> %zero_f32x8 shape [%m, %n] : vector<8xf32>

  // Stage the first K block, then run a double-buffered loop: each iteration
  // issues the global loads for block k+1 before doing block k's MMA, so the
  // load latency hides behind the matrix ops, and writes them into the other
  // slab so only one barrier per step is needed. This is what Triton's
  // num_stages=2 does for inductor's k-loop.
  scf.for %half = [%c0 to %c2 step %c1] {
    %row_offset = index.mul %half, %c32 : index
    %row = index.add %load_row, %row_offset : index
    %source_m = index.add %base_m, %row : index
    %m_in_range = index.cmp ult, %source_m, %m_size : index
    %a_values = scf.if %m_in_range -> (vector<4xf16>) {
      %bounded = index.assume %source_m [lt(%source_m, %m_size)] : index
      %wide = vector.load %a_view[%bounded, %load_k] : view<[%m_size]x[%k_size]xf32> -> vector<4xf32>
      %narrow = vector.fptrunc %wide : vector<4xf32> to vector<4xf16>
      scf.yield %narrow : vector<4xf16>
    } else {
      scf.yield %zero_f16x4 : vector<4xf16>
    }
    vector.store %a_values, %a_stage_view[%row, %load_k] : vector<4xf16>, view<128x40xf16>
    %source_n = index.add %base_n, %row : index
    %w_values = vector.load %w_view[%source_n, %load_k] : view<[%n_size]x[%k_size]xf16> -> vector<4xf16>
    vector.store %w_values, %w_stage_view[%row, %load_k] : vector<4xf16>, view<128x40xf16>
  }

  %acc0, %acc1 = scf.for %k_base = [%c0 to %k_size step %c32](%run0 = %acc_init0 : vector<8xf32>, %run1 = %acc_init1 : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>) {
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)

    %block = index.div %k_base, %c32 : index
    %parity = index.rem %block, %c2 : index
    %slab = index.mul %parity, %c64 : index
    %other_parity = index.sub %c1, %parity : index
    %other_slab = index.mul %other_parity, %c64 : index

    // Prefetch block k+1. When there is no next block the index is clamped to a
    // valid one and the values are written into a slab nothing reads again.
    %next_k = index.add %k_base, %c32 : index
    %has_next = index.cmp ult, %next_k, %k_size : index
    %safe_next = scf.select %has_next, %next_k, %c0 : index
    %prefetch_k0 = index.add %safe_next, %load_k : index
    // safe_next is a multiple of 32 no greater than k_size - 32 and load_k < 32,
    // but the select breaks that inference, so state it.
    %k_vector_limit = index.sub %k_size, %c4 : index
    %prefetch_k = index.assume %prefetch_k0 [le(%prefetch_k0, %k_vector_limit)] : index

    %prefetch_a0, %prefetch_w0, %prefetch_a1, %prefetch_w1 = scf.for %half = [%c0 to %c2 step %c1](%a0 = %zero_f16x4 : vector<4xf16>, %w0 = %zero_f16x4 : vector<4xf16>, %a1 = %zero_f16x4 : vector<4xf16>, %w1 = %zero_f16x4 : vector<4xf16>) -> (vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>) unroll {
      %row_offset = index.mul %half, %c32 : index
      %row = index.add %load_row, %row_offset : index
      %source_m = index.add %base_m, %row : index
      %m_in_range = index.cmp ult, %source_m, %m_size : index
      %a_values = scf.if %m_in_range -> (vector<4xf16>) {
        %bounded = index.assume %source_m [lt(%source_m, %m_size)] : index
        %wide = vector.load %a_view[%bounded, %prefetch_k] : view<[%m_size]x[%k_size]xf32> -> vector<4xf32>
        %narrow = vector.fptrunc %wide : vector<4xf32> to vector<4xf16>
        scf.yield %narrow : vector<4xf16>
      } else {
        scf.yield %zero_f16x4 : vector<4xf16>
      }
      %source_n = index.add %base_n, %row : index
      %w_values = vector.load %w_view[%source_n, %prefetch_k] : view<[%n_size]x[%k_size]xf16> -> vector<4xf16>
      %is_second = index.cmp eq, %half, %c1 : index
      %out_a0 = scf.select %is_second, %a0, %a_values : vector<4xf16>
      %out_w0 = scf.select %is_second, %w0, %w_values : vector<4xf16>
      %out_a1 = scf.select %is_second, %a_values, %a1 : vector<4xf16>
      %out_w1 = scf.select %is_second, %w_values, %w1 : vector<4xf16>
      scf.yield %out_a0, %out_w0, %out_a1, %out_w1 : vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>
    }

    %wave_row_slab = index.add %wave_row, %slab : index
    %wave_col_slab = index.add %wave_col, %slab : index
    %wave_col1_slab = index.add %wave_col1, %slab : index
    %next0, %next1 = scf.for %k_half = [%c0 to %c32 step %c16](%half0 = %run0 : vector<8xf32>, %half1 = %run1 : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>) unroll {
      %lhs = vector.fragment.load<lhs> %a_stage_view[%wave_row_slab, %k_half] shape [%m, %k] : view<128x40xf16> -> vector<16xf16>
      %rhs0 = vector.fragment.load<rhs> %w_fragment_view[%k_half, %wave_col_slab] shape [%k, %n] : view<32x128xf16, %w_fragment_layout> -> vector<16xf16>
      %rhs1 = vector.fragment.load<rhs> %w_fragment_view[%k_half, %wave_col1_slab] shape [%k, %n] : view<32x128xf16, %w_fragment_layout> -> vector<16xf16>
      %out0 = vector.mma %lhs, %rhs0, %half0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
      %out1 = vector.mma %lhs, %rhs1, %half1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
      scf.yield %out0, %out1 : vector<8xf32>, vector<8xf32>
    }

    %store_row0 = index.add %load_row, %other_slab : index
    %store_row1 = index.add %store_row0, %c32 : index
    vector.store %prefetch_a0, %a_stage_view[%store_row0, %load_k] : vector<4xf16>, view<128x40xf16>
    vector.store %prefetch_w0, %w_stage_view[%store_row0, %load_k] : vector<4xf16>, view<128x40xf16>
    vector.store %prefetch_a1, %a_stage_view[%store_row1, %load_k] : vector<4xf16>, view<128x40xf16>
    vector.store %prefetch_w1, %w_stage_view[%store_row1, %load_k] : vector<4xf16>, view<128x40xf16>
    scf.yield %next0, %next1 : vector<8xf32>, vector<8xf32>
  }

  // Publish through LDS: each lane takes two vector4 slices of the 16x16 tile.
  %publish_row0 = index.div %lane, %c4 : index
  %publish_row1 = index.add %publish_row0, %c8 : index
  %publish_col_group = index.rem %lane, %c4 : index
  %publish_col = index.mul %publish_col_group, %c4 : index

  scf.for %fragment = [%c0 to %c2 step %c1] {
    %is_second = index.cmp eq, %fragment, %c1 : index
    %chosen = scf.select %is_second, %acc1, %acc0 : vector<8xf32>
    vector.fragment.store<result> %chosen, %result_view[%c0, %c0] shape [%m, %n] : vector<8xf32>, view<16x16xf32>
    kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)

    %fragment_col_offset = index.mul %fragment, %c16 : index
    %tile_col = index.add %wave_col, %fragment_col_offset : index
    %out_col_local = index.add %tile_col, %publish_col : index
    %out_col = index.add %base_n, %out_col_local : index
    %bias_values = vector.load %bias_view[%out_col] : view<[%n_size]xf32> -> vector<4xf32>

    scf.for %half = [%c0 to %c2 step %c1] {
      %row_offset = index.mul %half, %c8 : index
      %publish_row = index.add %publish_row0, %row_offset : index
      %values = vector.load %result_view[%publish_row, %publish_col] : view<16x16xf32> -> vector<4xf32>
      %biased = vector.addf %values, %bias_values : vector<4xf32>
      %row_local = index.add %wave_row, %publish_row : index
      %out_row = index.add %base_m, %row_local : index
      %writes = index.cmp ult, %out_row, %m_size : index
      scf.if %writes {
        %bounded = index.assume %out_row [lt(%out_row, %m_size)] : index
        vector.store %biased, %c_view[%bounded, %out_col] : vector<4xf32>, view<[%m_size]x[%n_size]xf32>
      }
    }
    kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
  }
  kernel.return
}
