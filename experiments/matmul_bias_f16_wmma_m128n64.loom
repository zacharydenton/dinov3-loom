    %out_col1 = index.add %base_n, %col1 : index
    %bias1 = vector.load %bias_view[%out_col1] : view<[%n_size]xf32> -> vector<4xf32>
    %biased1 = vector.addf %values1, %bias1 : vector<4xf32>
    %out_row1 = index.add %token_origin1, %row1 : index
    %writes1 = index.cmp ult, %out_row1, %m_size : index
    scf.if %writes1 {
      %bounded1 = index.assume %out_row1 [lt(%out_row1, %m_size)] : index
      vector.store %biased1, %c_view[%bounded1, %out_col1] : vector<4xf32>, view<[%m_size]x[%n_size]xf32>
    }
  }
  kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)

  vector.fragment.store<result> %result20, %stage_view[%c0, %c0] shape [%m, %n] : vector<8xf32>, view<16x68xf32>
  vector.fragment.store<result> %result21, %stage_view[%c0, %c16] shape [%m, %n] : vector<8xf32>, view<16x68xf32>
  vector.fragment.store<result> %result22, %stage_view[%c0, %c32] shape [%m, %n] : vector<8xf32>, view<16x68xf32>
  vector.fragment.store<result> %result23, %stage_view[%c0, %c48] shape [%m, %n] : vector<8xf32>, view<16x68xf32>
