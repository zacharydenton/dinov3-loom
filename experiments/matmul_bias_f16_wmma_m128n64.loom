  vector.fragment.store<result> %result31, %stage_view[%c0, %c16] shape [%m, %n] : vector<8xf32>, view<16x68xf32>
  vector.fragment.store<result> %result32, %stage_view[%c0, %c32] shape [%m, %n] : vector<8xf32>, view<16x68xf32>
  vector.fragment.store<result> %result33, %stage_view[%c0, %c48] shape [%m, %n] : vector<8xf32>, view<16x68xf32>
  kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
